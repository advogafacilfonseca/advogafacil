<service>
  <id>AdvogaFacilServidor</id>
  <name>Advoga Fácil Servidor</name>
  <description>API central do Advoga Fácil.</description>
  <executable>%BASE%\..\servidor\AdvogaFacilServidor.exe</executable>
  <arguments>servir</arguments>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <depend>AdvogaFacilPostgreSQL</depend>
  <env name="ADVOGA_HOST" value="0.0.0.0"/>
  <env name="ADVOGA_PORTA" value="8765"/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <logpath>%ProgramData%\AdvogaFacil\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>8</keepFiles></log>
</service>
